# ─── LLM (adapter multi-proveedor de la fábrica) ─────────────────────────────
# Runtime de la demo: Gemini 2.0 Flash free tier. Cambiar de proveedor =
# cambiar estas variables, cero cambios de código (ver agent/llm.js).
# Proveedores: anthropic | groq | deepseek | gemini | openrouter | ollama | openai-compat
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
# LLM_BASE_URL=              # solo para openai-compat

# Solo si LLM_PROVIDER=anthropic (el cliente lo paga explícitamente):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Modo mock ────────────────────────────────────────────────────────────────
# true: fuerza respuestas simuladas en telegram/bot.js y scripts/test-chat.js,
# sin llamar nunca al LLM (ni gastar tokens). npm test es SIEMPRE mock.
MOCK=false

# ─── Supabase (solo producción) ───────────────────────────────────────────────
# Si se dejan vacías, el agente usa la base EN MEMORIA con las semillas del
# SPEC (8 propiedades, 1 visita, 1 lead) — las visitas y leads NO sobreviven a
# un reinicio. Para producción: ejecutar database/schema.sql y llenar esto.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── WhatsApp Cloud API (Meta) — canal de producción, fuera de alcance v1 ────
# Si WHATSAPP_TOKEN está vacío, el sender imprime los mensajes por consola.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=un-token-que-tu-inventes
WHATSAPP_APP_SECRET=

# ─── Telegram (opcional — fuera de alcance v1) ────────────────────────────────
# Token de @BotFather. Vacío = `npm run telegram` arranca en modo MOCK (simula
# conversaciones inmobiliarias por consola, sin Telegram real ni API del LLM).
TELEGRAM_TOKEN_INMOBILIARIA=

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3300

# ─── Negocio ──────────────────────────────────────────────────────────────────
# Minutos por slot de visita (default 30 → 6 slots por día Lu/Mi/Ju 11:00-14:00)
SLOT_MINUTOS=30
# Valor UF referencial en CLP para conversiones aproximadas (constante, sin API)
UF_CLP=39500
