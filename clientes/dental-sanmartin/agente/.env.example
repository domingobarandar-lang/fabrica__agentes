# ─── Anthropic (Claude) ─────────────────────────────────────────────────────────
# Obligatoria para producción. En modo demo (MOCK=true / npm run telegram:mock)
# no se necesita ninguna API key. Crear la key en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Modo mock ────────────────────────────────────────────────────────────────
# true: fuerza respuestas simuladas en telegram/bot.js y scripts/test-chat.js,
# sin llamar nunca a Anthropic (ni gastar créditos). false/vacío: usa el
# modelo real si hay ANTHROPIC_API_KEY (si no hay key, cae a mock igual).
MOCK=false

# ─── Supabase (COMPARTIDO con agente-retail) ───────────────────────────────────
# Si se dejan vacías, el agente usa una base EN MEMORIA con datos de ejemplo
# (las citas no sobreviven a un reinicio — suficiente para la demo).
# Ambos agentes son demos y usan el MISMO proyecto Supabase: mismo SUPABASE_URL
# y misma SUPABASE_ANON_KEY en el .env de agente-citas y de agente-retail.
# Correr schema-compartido.sql (raíz del repo) una sola vez en ese proyecto —
# crea las tablas de los dos agentes, cada una con RLS deshabilitado (demo),
# así que la clave anon funciona sin dar "permission denied".
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Si WHATSAPP_TOKEN está vacío, el sender imprime los mensajes por consola
# (modo demo, sin integración real con Meta).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=un-token-que-tu-inventes
WHATSAPP_APP_SECRET=

# ─── Telegram (gratis — alternativa a WhatsApp para demos) ────────────────────
# Token del bot: crearlo con @BotFather en Telegram (/newbot) y pegarlo aquí.
# Si está vacío, `npm run telegram` arranca en modo MOCK (simula conversaciones
# por consola, sin Telegram real ni API de Anthropic).
# NOTA: en deploy unificado (Railway, un solo proceso con index.js en la raíz),
# este bot usa TELEGRAM_TOKEN_CITAS en vez de TELEGRAM_BOT_TOKEN.
TELEGRAM_TOKEN_CITAS=

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3300

# ─── Negocio (opcional) ───────────────────────────────────────────────────────
# Minutos por bloque de agenda (default 60)
SLOT_MINUTOS=60
