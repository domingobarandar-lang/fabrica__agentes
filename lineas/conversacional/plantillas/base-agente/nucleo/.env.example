# Variables del núcleo conversacional. Copiar a .env y completar.
# El .env NUNCA se sube a git ni a Notion (el .gitignore del núcleo ya lo cubre).

# ─── Proveedor de LLM ─────────────────────────────────────────────────────────
# REGLA DURA: nunca asumir Anthropic por defecto. El proveedor se elige según
# docs/ARQUITECTURA.md; Anthropic solo si el cliente lo paga explícitamente.
LLM_PROVIDER=gemini          # anthropic | groq | deepseek | gemini | openrouter | ollama | openai-compat
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
# LLM_BASE_URL=              # solo para openai-compat

# ─── Límites del turno ────────────────────────────────────────────────────────
MAX_TOKENS_RESPUESTA=600
TIMEOUT_MODELO_MS=25000      # timeout duro por llamada (AbortController)
INTENTOS_MODELO=3            # intentos TOTALES, no adicionales

# ─── Agrupación de mensajes ───────────────────────────────────────────────────
BUFFER_MS=6000               # 0 lo desactiva. La ventana mide el silencio.
BUFFER_MAX_PARTES=10
# Excepciones que NO esperan la ventana. "handoff" está forzado en código y no
# se puede sacar: si el cliente pide una persona y el proceso se reinicia
# durante la ventana, nadie se entera de que pidió ayuda.
BUFFER_EXCEPCIONES=handoff,cancelacion,adjunto

# ─── Derivación a humano ──────────────────────────────────────────────────────
HANDOFF_ACTIVO=true
# VACÍO = la derivación es DEFINITIVA (default, y es lo que se recomienda).
# Poner un número de minutos hace que el bot retome solo tras ese silencio;
# es una decisión de negocio, no técnica, y hay que conversarla con el cliente.
HANDOFF_TIMEOUT_MIN=
HANDOFF_MAX_FALLOS=3         # fallos técnicos seguidos antes de derivar. 0 lo apaga.
HANDOFF_INBOX=               # a quién avisar (correo, chat interno, etc.)

# ─── Métricas ─────────────────────────────────────────────────────────────────
METRICAS_ACTIVAS=true

# ─── Canales ──────────────────────────────────────────────────────────────────
# Telegram
TELEGRAM_TOKEN=
# TELEGRAM_TOKEN_VAR=        # si el token vive en otra variable ya en uso

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=         # sin esto el webhook FALLA CERRADO en producción

# ─── Base de datos ────────────────────────────────────────────────────────────
# Sin estas, la base es en memoria y cada redeploy la borra (sirve para demo).
# Usar la key service_role: la anon da "permission denied" con RLS.
# El proyecto Supabase está COMPARTIDO entre agentes: toda tabla va PREFIJADA.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
