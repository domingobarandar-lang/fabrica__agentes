# SECRETOS del agente. Copiar a .env y completar.
# El .env NUNCA se sube a git ni a Notion (el .gitignore del núcleo ya lo cubre).
#
# ACÁ VAN SOLO SECRETOS Y CONEXIONES. El COMPORTAMIENTO del agente (buffer,
# handoff, límites, canales, tablas) se declara en `agente.config.json`, que sí
# se versiona y se revisa. Esa separación no es estética: antes este archivo
# traía BUFFER_MS, HANDOFF_* y MAX_TOKENS_* descomentados, así que copiarlo tal
# cual habría tapado la configuración entera y el archivo declarativo no habría
# servido de nada. Corre `npm run validar` y te dice si alguna variable de acá
# está pisando la config.

# ─── Proveedor de LLM ─────────────────────────────────────────────────────────
# REGLA DURA: nunca asumir Anthropic por defecto. El proveedor se elige según
# docs/ARQUITECTURA.md; Anthropic solo si el cliente lo paga explícitamente.
# NO va en agente.config.json a propósito: es credencial y es costo.
LLM_PROVIDER=gemini          # anthropic | groq | deepseek | gemini | openrouter | ollama | openai-compat
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
# LLM_BASE_URL=              # solo para openai-compat

# ─── Canales ──────────────────────────────────────────────────────────────────
# Los NOMBRES de estas variables se declaran en agente.config.json
# (canales.*.token_env); acá van los valores.
TELEGRAM_TOKEN=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=         # sin esto el webhook FALLA CERRADO en producción

# ─── Base de datos ────────────────────────────────────────────────────────────
# Sin estas, la base es en memoria y cada redeploy la borra (sirve para demo).
# Usar la key service_role: la anon da "permission denied" con RLS.
# Los NOMBRES de las tablas salen de `datos.prefijo` en agente.config.json — el
# proyecto Supabase está COMPARTIDO entre agentes y una tabla sin prefijo cruza
# datos entre negocios distintos.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Overrides de emergencia (déjalos comentados) ────────────────────────────
# Pisan agente.config.json sin redeploy: sirven para apagar algo a las 3 AM, no
# para configurar el agente. Descomentar uno y olvidarlo es tener el agente
# corriendo con una configuración que no está en ningún archivo revisado, así
# que `npm run validar` los denuncia mientras estén activos.
#
# HANDOFF_ACTIVO=false       # apagar la derivación a humano
# BUFFER_MS=0                # desactivar la agrupación de mensajes
# TIMEOUT_MODELO_MS=25000
# INTENTOS_MODELO=3
# MAX_TOKENS_RESPUESTA=600
# METRICAS_ACTIVAS=false
# CONOCIMIENTO_ACTIVO=false  # apagar la carga de conocimiento del negocio
# ESTILO_ACTIVO=false       # apagar el contrato de forma (mensajes cortos, sin Markdown)
